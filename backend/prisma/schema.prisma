generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleType {
  TRAINER
  JUROR
  JURYLEITUNG
}

enum RoleApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  firstName String
  lastName  String
  birthDate DateTime

  vereine     UserIsInVerein[]
  trainer     Trainer?
  juror       Juror?
  juryleitung Juryleitung?
  isAdmin     Boolean          @default(false)

  roleApplications RoleApplication[]

  einzelkueren             EinzelkuerFahrer[]
  paarkueren               PaarkuerFahrer[]
  kleingruppenkueren       KleingruppenkuerFahrer[]
  kleingruppenErsatzkueren KleingruppenkuerErsatzfahrer[]
  grossgruppenkueren       GrossgruppenkuerFahrer[]
  grossgruppenErsatzkueren GrossgruppenkuerErsatzfahrer[]

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Verein {
  id    Int    @id @default(autoincrement())
  name  String
  email String

  users            UserIsInVerein[]
  juroren          Juror[]
  competitions     Competition[]
  roleApplications RoleApplication[]

  einzelkueren       Einzelkuer[]
  paarkueren         Paarkuer[]
  kleingruppenkueren Kleingruppenkuer[]
  grossgruppenkueren Grossgruppenkuer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserIsInVerein {
  user_id   Int
  verein_id Int

  user   User   @relation(fields: [user_id], references: [id])
  verein Verein @relation(fields: [verein_id], references: [id])

  @@id([user_id, verein_id])
}

model Trainer {
  user_id Int @id

  user User @relation(fields: [user_id], references: [id])
}

model RoleApplication {
  id Int @id @default(autoincrement())

  user_id Int
  role    RoleType
  status  RoleApplicationStatus @default(PENDING)

  verein_id Int?
  reason    String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy Int?

  user   User    @relation(fields: [user_id], references: [id])
  verein Verein? @relation(fields: [verein_id], references: [id])

  @@index([user_id])
  @@index([status])
}

model Competition {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  startDate DateTime
  endDate   DateTime

  location String

  verein_id Int
  verein    Verein @relation(fields: [verein_id], references: [id])

  einzelkueren       Einzelkuer[]
  paarkueren         Paarkuer[]
  kleingruppenkueren Kleingruppenkuer[]
  grossgruppenkueren Grossgruppenkuer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Einzelkuer {
  id Int @id @default(autoincrement())

  competition_id Int
  verein_id      Int

  titel       String
  platzierung Int?

  competition Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  verein      Verein      @relation(fields: [verein_id], references: [id])

  fahrer EinzelkuerFahrer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EinzelkuerFahrer {
  kuer_id Int
  user_id Int

  kuer Einzelkuer @relation(fields: [kuer_id], references: [id], onDelete: Cascade)
  user User       @relation(fields: [user_id], references: [id])

  @@id([kuer_id, user_id])
}

model Paarkuer {
  id Int @id @default(autoincrement())

  competition_id Int
  verein_id      Int

  titel       String
  platzierung Int?

  competition Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  verein      Verein      @relation(fields: [verein_id], references: [id])

  fahrer PaarkuerFahrer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaarkuerFahrer {
  kuer_id Int
  user_id Int

  kuer Paarkuer @relation(fields: [kuer_id], references: [id], onDelete: Cascade)
  user User     @relation(fields: [user_id], references: [id])

  @@id([kuer_id, user_id])
}

model Kleingruppenkuer {
  id Int @id @default(autoincrement())

  competition_id Int
  verein_id      Int

  titel               String
  fahrer_anzahl       Int
  ersatzfahrer_anzahl Int
  platzierung         Int?

  competition Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  verein      Verein      @relation(fields: [verein_id], references: [id])

  fahrer       KleingruppenkuerFahrer[]
  ersatzfahrer KleingruppenkuerErsatzfahrer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KleingruppenkuerFahrer {
  kuer_id Int
  user_id Int

  kuer Kleingruppenkuer @relation(fields: [kuer_id], references: [id], onDelete: Cascade)
  user User             @relation(fields: [user_id], references: [id])

  @@id([kuer_id, user_id])
}

model KleingruppenkuerErsatzfahrer {
  kuer_id Int
  user_id Int

  kuer Kleingruppenkuer @relation(fields: [kuer_id], references: [id], onDelete: Cascade)
  user User             @relation(fields: [user_id], references: [id])

  @@id([kuer_id, user_id])
}

model Grossgruppenkuer {
  id Int @id @default(autoincrement())

  competition_id Int
  verein_id      Int

  titel               String
  fahrer_anzahl       Int
  ersatzfahrer_anzahl Int
  platzierung         Int?

  competition Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  verein      Verein      @relation(fields: [verein_id], references: [id])

  fahrer       GrossgruppenkuerFahrer[]
  ersatzfahrer GrossgruppenkuerErsatzfahrer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GrossgruppenkuerFahrer {
  kuer_id Int
  user_id Int

  kuer Grossgruppenkuer @relation(fields: [kuer_id], references: [id], onDelete: Cascade)
  user User             @relation(fields: [user_id], references: [id])

  @@id([kuer_id, user_id])
}

model GrossgruppenkuerErsatzfahrer {
  kuer_id Int
  user_id Int

  kuer Grossgruppenkuer @relation(fields: [kuer_id], references: [id], onDelete: Cascade)
  user User             @relation(fields: [user_id], references: [id])

  @@id([kuer_id, user_id])
}

model Juror {
  user_id    Int @id
  vereins_id Int

  t Boolean @default(false)
  p Boolean @default(false)
  a Boolean @default(true)

  user   User   @relation(fields: [user_id], references: [id])
  verein Verein @relation(fields: [vereins_id], references: [id])
}

model Juryleitung {
  user_id Int @id

  user User @relation(fields: [user_id], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
